double g(const double a, const double b)
{
    return ((a * a) + a * b + (b * b));
}

double z(double s, double t)
{
    return (g(1, s) + pow(1 + pow(g(t, 1), 2), 2)) /
        (1 + pow(g(s + t, 1), 3));
}
